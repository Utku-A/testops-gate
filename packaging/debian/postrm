#!/bin/sh
set -e

if [ "$1" = "purge" ]; then
    # Certificates, users, state and logs
    rm -rf /etc/testops-gate /var/lib/testops-gate /var/log/testops-gate
    if getent group testops-gate >/dev/null; then
        groupdel testops-gate 2>/dev/null || true
    fi
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
