"""testops-gate-node: join this server to a TestOps Gate VPN.

    testops-gate-node join tgj1_...   (the command `testops-gate node add NAME` prints)
    testops-gate-node status
    testops-gate-node dns-sync        (run every minute by testops-gate-node-dns.timer)
    testops-gate-node leave

The private key is made here and never leaves this server: the VPN server only signs a certificate
request. Before anything is sent, the join service is checked against the CA fingerprint in the
join command. The connection runs as openvpn-client@testops-gate (starts at boot, reconnects).

This server's own traffic and DNS are not changed. The names the VPN resolves (other servers and
the host records of the VPN server) are routed to the VPN's DNS: with systemd-resolved as routing
domains of the tunnel; without it, as a managed block in /etc/hosts (wildcard names cannot be
listed there). The list comes from the VPN's DNS and is refreshed every minute.

Standard library only: this package must stay small on the servers it is installed on.
"""

from __future__ import annotations

import base64
import hashlib
import json
import os
import re
import shutil
import socket
import ssl
import struct
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import NoReturn

CONF_DIR = Path("/etc/testops-gate-node")
CLIENT_CONF = Path("/etc/openvpn/client/testops-gate.conf")
UNIT = "openvpn-client@testops-gate.service"
DEVICE = "tgnode"
DNS_UP = "/usr/lib/testops-gate-node/dns-up"
DNS_TIMER = "testops-gate-node-dns.timer"
DNS_STATE = Path("/run/testops-gate-node/dns.json")
HOSTS_FILE = Path("/etc/hosts")
HOSTS_BEGIN = "# BEGIN testops-gate-node: names in the VPN (managed, do not edit)"
HOSTS_END = "# END testops-gate-node"
DNS_PORT = 53
NAMES_LABEL = "_names._testops-gate"  # TXT records the VPN server answers to joined servers only
LABEL_RE = re.compile(r"^[a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9])?$")
TIMEOUT = 20


def say(msg: str) -> None:
    print(f"  {msg}", flush=True)


def fail(msg: str, *hints: str) -> NoReturn:
    print(f"  ✗ {msg}", file=sys.stderr)
    for hint in hints:
        print(f"    {hint}", file=sys.stderr)
    sys.exit(1)


def run(*cmd: str, check: bool = True) -> subprocess.CompletedProcess:
    proc = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if check and proc.returncode:
        fail(f"{' '.join(cmd[:3])} failed: {(proc.stderr or proc.stdout).strip()[-300:]}")
    return proc


def decode(blob: str) -> dict:
    if not blob.startswith("tgj1_"):
        fail("this is not a join command from `testops-gate node add`")
    raw = blob[5:]
    try:
        data = json.loads(base64.urlsafe_b64decode(raw + "=" * (-len(raw) % 4)))
        return {"endpoint": data["e"], "token": data["t"], "ca_hash": data["h"], "name": data["n"]}
    except (ValueError, KeyError):
        fail("the join command is damaged; copy it again from `testops-gate node add`")


def der_sha256(pem: str) -> str:
    start = pem.index("-----BEGIN CERTIFICATE-----")
    end = pem.index("-----END CERTIFICATE-----", start) + len("-----END CERTIFICATE-----")
    return hashlib.sha256(ssl.PEM_cert_to_DER_cert(pem[start:end])).hexdigest()


def pinned_context(ca: str) -> ssl.SSLContext:
    """TLS context that trusts only the pinned CA."""
    context = ssl.create_default_context(cadata=ca)
    context.check_hostname = False  # the CA is pinned; the address may be an IP or any name
    # Python 3.13+ checks certificates strictly by default and rejects CAs made by easy-rsa 3.0
    # (Debian 12, Ubuntu 22.04), whose basicConstraints is not marked critical
    context.verify_flags &= ~ssl.VERIFY_X509_STRICT
    return context


def request(url: str, context: ssl.SSLContext, body: dict | None = None) -> bytes:
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"} if data else {})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT, context=context) as resp:
            return resp.read()
    except urllib.error.HTTPError as exc:
        try:
            reason = json.loads(exc.read()).get("error", exc.reason)
        except ValueError:
            reason = exc.reason
        fail(f"the VPN server refused: {reason}", "Create a new join command: sudo testops-gate node add NAME")
    except (urllib.error.URLError, OSError) as exc:
        host = url.split("/")[2]
        reason = getattr(exc, "reason", exc)
        if isinstance(reason, ConnectionRefusedError):
            fail(f"the join service at {host} is not running (connection refused)",
                 "The join command has probably expired. On the VPN server, create a new one:",
                 "    sudo testops-gate node add NAME      (dashboard: Servers → n)",
                 "If it has not expired, see why the join service stopped: sudo journalctl -u testops-gate-enroll -n 20")
        if isinstance(reason, ssl.SSLError):
            fail(f"secure connection to the join service at {host} failed: {reason}",
                 "Update testops-gate on both servers and create a new join command.")
        fail(f"cannot reach the join service at {host}: {getattr(exc, 'reason', exc)}",
             f"Open {host.rsplit(':', 1)[-1]}/tcp to the VPN server in its cloud firewall while joining.")


# --- DNS: the names the VPN resolves ------------------------------------------------------------


def _recv(sock: socket.socket, size: int) -> bytes:
    data = b""
    while len(data) < size:
        chunk = sock.recv(size - len(data))
        if not chunk:
            raise OSError("DNS connection closed")
        data += chunk
    return data


def _skip_name(buf: bytes, pos: int) -> int:
    while True:
        length = buf[pos]
        if length == 0:
            return pos + 1
        if length & 0xC0 == 0xC0:  # compression pointer
            return pos + 2
        pos += length + 1


def dns_query(server: str, name: str, qtype: int, timeout: float = 5.0) -> list[bytes]:
    """The rdata of the answers of type `qtype` (16 TXT, 1 A); [] for NXDOMAIN. DNS over TCP: no
    truncation however long the list is."""
    qname = b"".join(bytes([len(label)]) + label.encode() for label in name.strip(".").split(".")) + b"\0"
    ident = int.from_bytes(os.urandom(2), "big")
    message = struct.pack(">HHHHHH", ident, 0x0100, 1, 0, 0, 0) + qname + struct.pack(">HH", qtype, 1)
    with socket.create_connection((server, DNS_PORT), timeout=timeout) as sock:
        sock.sendall(struct.pack(">H", len(message)) + message)
        reply = _recv(sock, struct.unpack(">H", _recv(sock, 2))[0])
    rid, flags, questions, answers = struct.unpack(">HHHH", reply[:8])
    if rid != ident:
        raise OSError("unexpected DNS reply")
    if flags & 0xF == 3:
        return []
    if flags & 0xF:
        raise OSError(f"DNS error {flags & 0xF}")
    pos = 12
    for _ in range(questions):
        pos = _skip_name(reply, pos) + 4
    found = []
    for _ in range(answers):
        pos = _skip_name(reply, pos)
        rtype, _, _, length = struct.unpack(">HHIH", reply[pos:pos + 10])
        pos += 10
        if rtype == qtype:
            found.append(reply[pos:pos + length])
        pos += length
    return found


def txt_strings(rdata: bytes) -> str:
    out, pos = b"", 0
    while pos < len(rdata):
        out += rdata[pos + 1:pos + 1 + rdata[pos]]
        pos += 1 + rdata[pos]
    return out.decode("ascii", "replace")


def vpn_settings() -> tuple[str, str]:
    """The VPN's DNS server and domain, from the client configuration written at join."""
    text = CLIENT_CONF.read_text()
    dns = re.search(r"^setenv TG_DNS (\S+)", text, re.M)
    domain = re.search(r"^setenv TG_DOMAIN (\S+)", text, re.M)
    return (dns.group(1) if dns else ""), (domain.group(1) if domain else "internal")


def valid_name(name: str) -> bool:
    """A host name, or *.name for a wildcard: it ends up in resolvectl arguments and /etc/hosts."""
    labels = name[2:].split(".") if name.startswith("*.") else name.split(".")
    return 0 < len(name) <= 253 and all(LABEL_RE.match(label) for label in labels)


def vpn_names(dns: str, domain: str) -> list[str]:
    names = {txt_strings(r).strip().lower().rstrip(".") for r in dns_query(dns, f"{NAMES_LABEL}.{domain}", 16)}
    return sorted(n for n in names if valid_name(n))


def uses_resolved() -> bool:
    """systemd-resolved runs and the system's lookups go through it."""
    if not shutil.which("resolvectl"):
        return False
    if run("systemctl", "is-active", "systemd-resolved", check=False).stdout.strip() != "active":
        return False
    try:
        resolv = Path("/etc/resolv.conf").read_text()
    except OSError:
        resolv = ""
    try:
        nsswitch = Path("/etc/nsswitch.conf").read_text()
    except OSError:
        nsswitch = ""
    stub = re.search(r"^\s*nameserver\s+127\.0\.0\.5[34]\s*$", resolv, re.M)  # not a mention in a comment
    return bool(stub or re.search(r"^hosts:[^#\n]*\bresolve\b", nsswitch, re.M))


def hosts_block(lines: list[str]) -> None:
    """Replace (or with no lines, remove) our block in /etc/hosts."""
    try:
        text = HOSTS_FILE.read_text()
    except OSError:
        return
    kept = re.sub(rf"\n?{re.escape(HOSTS_BEGIN)}\n.*?{re.escape(HOSTS_END)}\n?", "\n", text, flags=re.S)
    kept = kept.rstrip("\n") + "\n"
    new = kept + (f"{HOSTS_BEGIN}\n" + "".join(f"{line}\n" for line in lines) + f"{HOSTS_END}\n" if lines else "")
    if new == text:
        return
    tmp = HOSTS_FILE.with_name(".hosts.testops-gate-node")
    tmp.write_text(new)
    os.chmod(tmp, os.stat(HOSTS_FILE).st_mode & 0o777)
    try:
        os.replace(tmp, HOSTS_FILE)
    except OSError:  # a bind-mounted /etc/hosts (containers) cannot be replaced, only rewritten
        tmp.unlink()
        HOSTS_FILE.write_text(new)


def dns_sync() -> dict:
    """Route the names the VPN resolves to the VPN's DNS; returns what was done."""
    dns, domain = vpn_settings()
    if not dns or "inet " not in run("ip", "-4", "addr", "show", "dev", DEVICE, check=False).stdout:
        return {"mode": "down"}
    names = vpn_names(dns, domain)
    if uses_resolved():
        hosts_block([])
        run("resolvectl", "dns", DEVICE, dns, check=False)
        routes = sorted({f"~{domain}"} | {f"~{n[2:] if n.startswith('*.') else n}" for n in names})
        run("resolvectl", "domain", DEVICE, *routes, check=False)
        result = {"mode": "resolved", "names": names}
    else:
        lines, skipped = [], []
        for name in names:
            if name.startswith("*."):
                skipped.append(name)
                continue
            for rdata in dns_query(dns, name, 1):
                lines.append(f"{socket.inet_ntoa(rdata)} {name}")
        hosts_block(lines)
        result = {"mode": "hosts", "names": names, "skipped": skipped}
    previous = {}
    try:
        previous = json.loads(DNS_STATE.read_text())
    except (OSError, ValueError):
        pass
    if previous != result:
        DNS_STATE.parent.mkdir(parents=True, exist_ok=True)
        DNS_STATE.write_text(json.dumps(result))
        print(f"{len(names)} names in the VPN resolve here ({describe_dns(result)})")
    return result


def describe_dns(result: dict) -> str:
    if result.get("mode") == "resolved":
        return "systemd-resolved"
    if result.get("mode") == "hosts":
        skipped = result.get("skipped") or []
        return "/etc/hosts" + (f"; wildcard names need systemd-resolved: {', '.join(skipped)}" if skipped else "")
    return "the VPN connection is down"


def write(path: Path, text: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def client_conf(s: dict) -> str:
    proto = "udp" if s["proto"] == "udp" else "tcp-client"
    return f"""# Written by `testops-gate-node join`: this server is {s['name']} ({s['vpn_ip']}) in the VPN.
client
dev {DEVICE}
dev-type tun
proto {proto}
remote {s['remote']} {s['port']}
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name {s['server_name']} name
auth SHA256
data-ciphers {s['data_ciphers']}
tls-client
tls-version-min 1.2
tls-cipher {s['tls_cipher']}
ca {CONF_DIR}/ca.crt
cert {CONF_DIR}/client.crt
key {CONF_DIR}/client.key
tls-crypt {CONF_DIR}/tls-crypt.key
auth-user-pass {CONF_DIR}/auth
# This server's own traffic and DNS stay as they are
pull-filter ignore "redirect-gateway"
pull-filter ignore "dhcp-option"
# Names in the VPN domain resolve through the VPN (systemd-resolved)
script-security 2
setenv TG_DNS {s['dns']}
setenv TG_DOMAIN {s['domain']}
up {DNS_UP}
verb 3
"""


def join(blob: str) -> int:
    info = decode(blob)
    if os.geteuid() != 0:
        fail("run as root: sudo testops-gate-node join ...")
    if CLIENT_CONF.exists():
        fail("this server has already joined a VPN", "To join again: sudo testops-gate-node leave")
    name, endpoint = info["name"], info["endpoint"]
    base = f"https://{endpoint}"
    say(f"Joining as {name} via {endpoint}")

    CONF_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(CONF_DIR, 0o700)
    key, csr = CONF_DIR / "client.key", CONF_DIR / "client.csr"
    run("openssl", "genpkey", "-algorithm", "EC", "-pkeyopt", "ec_paramgen_curve:P-256", "-out", str(key))
    os.chmod(key, 0o600)
    run("openssl", "req", "-new", "-key", str(key), "-subj", f"/CN={name}.node", "-out", str(csr))
    say("✓ Key made on this server (it is not sent anywhere)")

    # Trust on the hash in the join command, not on the network: fetch the CA, compare, then use it
    insecure = ssl.create_default_context()
    insecure.check_hostname = False
    insecure.verify_mode = ssl.CERT_NONE
    ca = request(f"{base}/ca", insecure).decode()
    if der_sha256(ca) != info["ca_hash"]:
        fail("the join service's certificate does not match the join command",
             "Someone may be intercepting the connection, or the join command is from another VPN server.")
    verified = pinned_context(ca)
    settings = json.loads(request(f"{base}/join", verified, {"token": info["token"], "csr": csr.read_text()}))
    csr.unlink()
    say(f"✓ Certificate issued · VPN address {settings['vpn_ip']}")

    write(CONF_DIR / "ca.crt", settings["ca"], 0o644)
    write(CONF_DIR / "client.crt", settings["cert"], 0o644)
    write(CONF_DIR / "tls-crypt.key", settings["tls_crypt"])
    write(CONF_DIR / "auth", f"{settings['username']}\n{settings['password']}\n")
    write(CONF_DIR / "node.json", json.dumps({k: settings[k] for k in ("name", "vpn_ip", "fqdn", "remote")}), 0o644)
    write(CLIENT_CONF, client_conf(settings))
    run("systemctl", "enable", "--now", UNIT)

    for _ in range(45):
        if settings["vpn_ip"] in run("ip", "-4", "addr", "show", "dev", DEVICE, check=False).stdout:
            break
        time.sleep(1)
    else:
        fail("joined, but the VPN connection did not come up within 45 seconds",
             f"Check: journalctl -u {UNIT} -n 30")
    run("systemctl", "enable", "--now", DNS_TIMER, check=False)
    try:
        result = dns_sync()
        say(f"✓ DNS: {len(result.get('names', []))} names in the VPN resolve here ({describe_dns(result)})")
    except OSError as exc:
        say(f"! DNS: could not read the names in the VPN yet ({exc}); retried every minute")
    print()
    say(f"✓ {name} is in the VPN as {settings['vpn_ip']} ({settings['fqdn']})")
    say("Other servers and VPN users reach it by that name. The connection starts at boot.")
    return 0


def status() -> int:
    if not CLIENT_CONF.exists():
        print("Not joined. Join with the command from `testops-gate node add NAME` on the VPN server.")
        return 1
    node = json.loads((CONF_DIR / "node.json").read_text())
    active = run("systemctl", "is-active", UNIT, check=False).stdout.strip() == "active"
    # the address comes from the device: the VPN server may have given this server a new one
    match = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", run("ip", "-4", "addr", "show", "dev", DEVICE, check=False).stdout)
    up = bool(match)
    print(f"{node['name']} · {node['fqdn']} · {match.group(1) if match else node['vpn_ip']} via {node['remote']}")
    print(f"connection: {'up' if active and up else 'down'} ({UNIT}: {'active' if active else 'inactive'})")
    try:
        dns = json.loads(DNS_STATE.read_text())
        print(f"dns: {len(dns.get('names', []))} names in the VPN resolve here ({describe_dns(dns)})")
    except (OSError, ValueError):
        print("dns: not synced yet (testops-gate-node dns-sync)")
    return 0 if active and up else 3


def leave() -> int:
    if os.geteuid() != 0:
        fail("run as root: sudo testops-gate-node leave")
    name = json.loads((CONF_DIR / "node.json").read_text())["name"] if (CONF_DIR / "node.json").exists() else "NAME"
    run("systemctl", "disable", "--now", DNS_TIMER, UNIT, check=False)
    hosts_block([])
    DNS_STATE.unlink(missing_ok=True)
    CLIENT_CONF.unlink(missing_ok=True)
    for path in CONF_DIR.glob("*"):
        path.unlink()
    print(f"Left the VPN. Also remove it on the VPN server: sudo testops-gate node remove {name}")
    return 0


def main(argv: list[str]) -> int:
    if len(argv) >= 2 and argv[0] == "join":
        return join(argv[1])
    if argv[:1] == ["status"]:
        return status()
    if argv[:1] == ["leave"]:
        return leave()
    if argv[:1] == ["dns-clean"]:  # package removal: our /etc/hosts block goes too
        hosts_block([])
        return 0
    if argv[:1] == ["dns-sync"]:
        if not CLIENT_CONF.exists():
            return 0
        try:
            dns_sync()
        except OSError as exc:  # the VPN is reconnecting: the timer tries again
            print(f"could not read the names in the VPN: {exc}", file=sys.stderr)
        return 0
    if argv[:1] in (["add"], ["list"], ["remove"], ["edit"]):
        # easy to mix up with `testops-gate node ...`, which runs on the VPN server
        name = argv[1] if len(argv) > 1 else "NAME"
        print("testops-gate-node only joins this server. Servers are managed on the VPN server:\n\n"
              f"    sudo testops-gate node {argv[0]}{'' if argv[0] == 'list' else ' ' + name}\n\n"
              "(dashboard: sudo testops-gate → Servers). Then run the join command it prints here:\n"
              "    sudo testops-gate-node join tgj1_...", file=sys.stderr)
        return 2
    print(__doc__.split("\n\n")[1] if __doc__ else "")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
