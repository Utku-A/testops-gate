#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# OpenVPN up script of testops-gate-node: names in the VPN resolve through the VPN's DNS.
# Never fails the connection. The VPN domain is routed at once (systemd-resolved); the full list of
# names (host records) follows from testops-gate-node dns-sync, started here and every minute.
if command -v resolvectl >/dev/null 2>&1 && [ -n "${dev:-}" ] && [ -n "${TG_DNS:-}" ]; then
    resolvectl dns "$dev" "$TG_DNS" >/dev/null 2>&1 || true
    resolvectl domain "$dev" "~${TG_DOMAIN:-internal}" >/dev/null 2>&1 || true
fi
systemctl start --no-block testops-gate-node-dns.service >/dev/null 2>&1 || true
exit 0
